{
  "$schema": "https://malesngonten.dev/schema/registry.json",
  "name": "malesngonten-registry",
  "components": {
    "Terminal-Simulator": {
      "name": "Terminal Simulator",
      "description": "Cinematic code typing animation component for Remotion with pitch-preserving micro-samples, multi-stage zoom, and rack-focus blur.",
      "type": "registry:component",
      "dependencies": [
        "zod",
        "remotion",
        "@remotion/media"
      ],
      "files": [
        {
          "path": "components/terminal-simulator/TypingDemo.tsx",
          "type": "registry:component"
        },
        {
          "path": "components/terminal-simulator/liquid-shader.tsx",
          "type": "registry:component"
        }
      ],
      "preview": "https://raw.githubusercontent.com/malesngonten/malesngonten-registry/main/components/terminal-simulator/assets/preview.mp4"
    },
    "Animated-Gradient": {
      "name": "Animated Gradient",
      "description": "Cinematic WebGL shader animated gradient component for Remotion supporting mist, lava, and vortex variants with frame-driven time synchronization.",
      "type": "registry:component",
      "dependencies": [
        "remotion",
        "zod"
      ],
      "files": [
        {
          "path": "components/animated-gradient/animated-gradient.tsx",
          "type": "registry:component"
        },
        {
          "path": "components/animated-gradient/SKILL.md",
          "type": "registry:component"
        }
      ]
    }
  }
}
{
  "$schema": "https://malesngonten.dev/schema/registry.json",
  "name": "malesngonten-registry",
  "components": {
    "Terminal-Simulator": {
      "name": "Terminal Simulator",
      "description": "Cinematic code typing animation component for Remotion with pitch-preserving micro-samples, multi-stage zoom, and rack-focus blur.",
      "type": "registry:component",
      "dependencies": [
        "zod",
        "remotion",
        "@remotion/media"
      ],
      "files": [
        {
          "path": "components/typography/terminal-simulator/TypingDemo.tsx",
          "type": "registry:component"
        },
        {
          "path": "components/typography/terminal-simulator/liquid-shader.tsx",
          "type": "registry:component"
        },
        {
          "path": "components/typography/terminal-simulator/terminal-simulator.element.tsx",
          "type": "registry:component"
        },
        {
          "path": "components/typography/terminal-simulator/SKILL.md",
          "type": "registry:component"
        }
      ],
      "preview": "https://raw.githubusercontent.com/malesngonten/malesngonten-registry/main/components/typography/terminal-simulator/assets/preview.mp4"
    },
    "Animated-Gradient": {
      "name": "Animated Gradient",
      "description": "Cinematic WebGL shader animated gradient component for Remotion supporting mist, lava, and vortex variants with frame-driven time synchronization.",
      "type": "registry:component",
      "dependencies": [
        "remotion",
        "zod"
      ],
      "files": [
        {
          "path": "components/backgrounds/animated-gradient/animated-gradient.tsx",
          "type": "registry:component"
        },
        {
          "path": "components/backgrounds/animated-gradient/animated-gradient.element.tsx",
          "type": "registry:component"
        },
        {
          "path": "components/backgrounds/animated-gradient/SKILL.md",
          "type": "registry:component"
        }
      ]
    },
    "Phone-Mockup": {
      "name": "Phone Mockup",
      "description": "3D Phone Mockup component for Remotion with GLTF model loading, screen synchronization, and responsive pose controls.",
      "type": "registry:component",
      "dependencies": [
        "remotion",
        "@remotion/three",
        "three",
        "@react-three/fiber",
        "zod"
      ],
      "files": [
        {
          "path": "components/mockups/phonemockup/phonemockup.tsx",
          "type": "registry:component"
        },
        {
          "path": "components/mockups/phonemockup/phonemockup.element.tsx",
          "type": "registry:component"
        },
        {
          "path": "components/mockups/phonemockup/SKILL.md",
          "type": "registry:component"
        }
      ]
    }
  }
